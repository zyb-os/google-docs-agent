# Orchestrator URL (default: http://localhost:8000)
ORCHESTRATOR_URL=http://localhost:8000

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional: override default credential/token file paths via env
# (can also be set in the orchestrator dashboard under agent settings)
# GDOCS_CREDENTIALS_FILE=credentials.json
# GDOCS_TOKEN_FILE=token.json
