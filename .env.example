# google-docs-agent — environment configuration
#
# !! SECRETS DO NOT BELONG HERE !!
# Google OAuth credentials (credentials.json, token.json) are file-based and
# must be placed in this directory, then their paths registered via the
# orchestrator dashboard:
#   http://<orchestrator>:8000  →  Agents  →  google-docs-agent  →  ⚙ Settings
#
# This file contains only non-secret infrastructure configuration.

# Orchestrator endpoint
ORCHESTRATOR_URL=http://localhost:8000

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Credential file path overrides — only if files are not in the default location
# GDOCS_CREDENTIALS_FILE=credentials.json
# GDOCS_TOKEN_FILE=token.json
